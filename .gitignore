# -------------------------------
# Python bytecode / cache (local only; Git must never track these)
# -------------------------------
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
*.py[cod]
*$py.class
*.pyo
*.pyd

# -------------------------------
# Build / packaging
# -------------------------------
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg

# -------------------------------
# Virtual environments
# -------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# -------------------------------
# Test / coverage / type checker
# -------------------------------
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.hypothesis/
**/.hypothesis/
.cache/
**/.cache/
.pytype/
**/.pytype/
.pyre/
**/.pyre/
.tox/
.nox/
.benchmarks/
coverage/
htmlcov/
coverage.xml
.coverage
.coverage.*
*.cover
*.py,cover
pytestdebug.log
.dmypy.json
dmypy.json

# -------------------------------
# Jupyter / IPython
# -------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# -------------------------------
# Logs / runtime artifacts
# -------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# -------------------------------
# Local environment / secrets
# -------------------------------
.env
.env.*
*.local
*.secret
secrets.*

# -------------------------------
# IDE / editor files
# -------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# -------------------------------
# OS-specific files
# -------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------------------------------
# Training runtime artifacts (CatBoost logs, temp dirs)
# -------------------------------
catboost_info/
artifacts/tmp/
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
!data/README.md
artifacts/**
!artifacts/
!artifacts/**/
!artifacts/.gitkeep
!artifacts/**/.gitkeep
